<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- TestFlight / App Store distribution. Xcode 16+ calls this
       "app-store-connect"; older toolchains use "app-store". -->
  <key>method</key>
  <string>app-store-connect</string>
  <key>teamID</key>
  <string>Q7742Z74Q3</string>
  <!-- Let Xcode resolve the distribution provisioning profile automatically. -->
  <key>signingStyle</key>
  <string>automatic</string>
  <key>uploadSymbols</key>
  <true/>
  <!-- Let Xcode pick the build number: on export it queries App Store Connect
       and stamps the .ipa with one past the latest build there. This is the
       auto-bump for TestFlight — the number always beats what's uploaded, so
       there is no collision and nothing local to keep in sync. (It needs the
       App Store Connect API key in ~/.appstoreconnect/private_keys to do the
       lookup; without it, export falls back to the archive's own number.) -->
  <key>manageAppVersionAndBuildNumber</key>
  <true/>
  <!-- Produce the .ipa only; uploading to App Store Connect is a separate,
       credential-authenticated step done by a human (Transporter/Xcode). -->
  <key>destination</key>
  <string>export</string>
</dict>
</plist>
