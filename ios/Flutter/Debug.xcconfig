#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"
#include? "Secrets.xcconfig"

// Debug builds are the dev app — appended to PRODUCT_BUNDLE_IDENTIFIER in the
// Xcode project so it becomes com.massapp.massdrive.dev and can coexist with a
// prod install. Release/Profile (Release.xcconfig) leave it empty -> prod id.
BUNDLE_ID_SUFFIX = .dev

// Maps key for the .dev bundle. Info.plist reads $(MAPS_API_KEY); Secrets.xcconfig
// (included above) supplies the per-bundle keys. Release.xcconfig picks _PROD.
MAPS_API_KEY = $(MAPS_API_KEY_DEV)

// Home-screen name, substituted into Info.plist as $(APP_DISPLAY_NAME). Marks
// the dev app apart from a prod install sitting next to it, matching APP_NAME
// in config/mass_dev.json (which drives the same label on Android).
APP_DISPLAY_NAME = Massdrive DEV

// APNs environment for the dev app: the sandbox (development) gateway, matching
// a development/ad-hoc provisioning profile. Substituted into Runner.entitlements
// as $(APS_ENVIRONMENT). Release.xcconfig uses production for prod/TestFlight.
APS_ENVIRONMENT = development
